# Copy this file to backend/.env and fill in real values. .env itself is
# gitignored (root .gitignore's `.env` pattern) — never commit it, and
# never hardcode these values in source.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Not itself secret — the same identifier already shipped inside the
# Flutter client's firebase_options.dart — but tests/test_invites.py
# needs it to sign in as the seeded test accounts, so it's configured
# the same way as everything else here.
FIREBASE_WEB_API_KEY=
# postgresql+psycopg://user:password@host:port/dbname — same var name
# Neon expects, so prod deployment is just a different value here.
DATABASE_URL=
