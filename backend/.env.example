# Copy this file to backend/.env and fill in real values. .env itself is
# gitignored (root .gitignore's `.env` pattern) — never commit it, and
# never hardcode these values in source.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Same var name Neon expects, so prod deployment is just a different
# value here. The value below matches docker-compose.yml's credentials
# exactly (a local-only dev password, not a real secret — safe to commit
# unlike everything else in this file) — `docker compose up -d` and this
# works with no edits.
DATABASE_URL=postgresql+psycopg://nyaymitra:nyaymitra_dev@localhost:5433/nyaymitra
# A real secret — generate your own, never reuse this or anyone else's:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
