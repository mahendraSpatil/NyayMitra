# Copy to deploy/.env.prod on the server and fill in. Never commit .env.prod.

# Public hostname. Azure gives a free one: set a DNS label on the VM's
# public IP -> <label>.<region>.cloudapp.azure.com
DOMAIN=nyaymitra.centralindia.cloudapp.azure.com

# Generate each with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
JWT_SECRET=

# Same values as your local backend/.env
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Model file name inside deploy/models/
MODEL_FILE=nyaymitra-demo.gguf
LLAMA_THREADS=2
